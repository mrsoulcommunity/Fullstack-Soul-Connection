{
  "name": "soul-connection",
  "productName": "Soul Connection",
  "version": "1.0.0",
  "description": "A modern V2Ray/Xray client for Windows",
  "main": "electron/main.cjs",
  "author": "Kasra",
  "license": "MIT",
  "scripts": {
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "dev": "vite build && electron .",
    "dist": "node scripts/build-exe.cjs",
    "dist:publish": "node scripts/build-exe.cjs --publish"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.kasra.soulconnection",
    "productName": "Soul Connection",
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mrsoulcommunity",
        "repo": "Fullstack-Soul-Connection"
      }
    ]
  }
}
